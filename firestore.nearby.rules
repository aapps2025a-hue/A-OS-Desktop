rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Existing A-Apps collection: preserved exactly.
  match /code/{document=**} { allow read, write: if true; }
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function profileValid(uid) {
   let d = request.resource.data;
   return d.keys().hasOnly(['username','key']) && d.username is string && d.key == d.username.lower()
    && d.username.matches('^[a-zA-Z0-9][a-zA-Z0-9-]{2,29}$')
    && !(d.key in ['admin','login','settings','api','assets','showcase','users'])
    && getAfter(/databases/$(database)/documents/abNames/$(d.key)).data.uid == uid;
  }
  function projectValid(slug) {
   let d=request.resource.data;
   return d.keys().hasOnly(['name','slug','files','updatedAt','publishedAt','domain','favicon','publishToApps'])
    && d.name is string && d.name.matches('^[a-zA-Z0-9][a-zA-Z0-9-]{0,39}$') && d.slug==slug && slug==d.name.lower()
    && d.files is map && d.files.size()<=50 && d.files['index.html'] is string && d.updatedAt is number;
  }
  match /abUsers/{uid} {
   allow read: if owner(uid);
   allow create,update: if owner(uid) && profileValid(uid);
   match /projects/{slug} {
    allow read,delete: if owner(uid);
    allow create,update: if owner(uid) && projectValid(slug);
   }
  }
  match /abNames/{key} {
   allow get: if true;
   allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid'])
    && request.resource.data.uid==request.auth.uid
    && getAfter(/databases/$(database)/documents/abUsers/$(request.auth.uid)).data.key==key;
   allow update: if request.auth != null && resource.data.uid==request.auth.uid && request.resource.data==resource.data;
   allow delete: if request.auth != null && resource.data.uid==request.auth.uid
    && getAfter(/databases/$(database)/documents/abUsers/$(request.auth.uid)).data.key!=key;
  }
  match /abShowcases/{uid} {
   allow get: if owner(uid) || resource.data.enabled == true;
   allow create,update: if owner(uid)
    && request.resource.data.keys().hasOnly(['enabled','color','avatar','header','order','hidden'])
    && request.resource.data.enabled is bool
    && request.resource.data.color in ['blue','green','pink','red','orange','black','white','yellow']
    && request.resource.data.avatar is string && request.resource.data.avatar.size() < 200000
    && request.resource.data.header is string && request.resource.data.header.size() < 450000
    && request.resource.data.order is list && request.resource.data.order.size() <= 200
    && request.resource.data.hidden is list && request.resource.data.hidden.size() <= 200;
  }
  match /abPublic/{uid}/sites/{slug} {
   allow list: if owner(uid) || get(/databases/$(database)/documents/abShowcases/$(uid)).data.enabled == true;
   allow get: if true;
   allow create,update: if owner(uid) && projectValid(slug);
   allow delete: if owner(uid);
  }

  function nearbyValid(uid) {
   let d = request.resource.data;
   return owner(uid)
    && d.keys().hasOnly(['ownerUid','payload','updatedAt'])
    && d.ownerUid == uid
    && d.payload is string
    && d.payload.size() < 850000
    && d.updatedAt is int;
  }
  match /aosNearbyUsers/{uid}/devices/{deviceId} {
   allow read: if owner(uid);
   allow create, update: if nearbyValid(uid);
   allow delete: if owner(uid);
   match /inbox/{transferId} {
    allow read: if owner(uid);
    allow create, update: if nearbyValid(uid);
    allow delete: if owner(uid);
    match /chunks/{chunkId} {
     allow read: if owner(uid);
     allow create, update: if nearbyValid(uid);
     allow delete: if owner(uid);
    }
   }
  }
  match /{allPaths=**} { allow read,write: if false; }
 }
}
