#!/bin/sh

set -eu

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main non-free-firmware" \
  --apt-recommends true \
  --debian-installer none \
  --memtest none \
  --bootappend-live "boot=live components quiet splash nox11autologin username=aos hostname=a-os locales=en_GB.UTF-8 keyboard-layouts=gb timezone=Europe/London console=tty0 console=ttyS0,115200n8" \
  --iso-application "A-OS Desktop" \
  --iso-publisher "A-OS Open Source" \
  --iso-volume "A-OS Desktop 1.2.1" \
  "${@}"
